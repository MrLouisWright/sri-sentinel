{
  "name": "sri-sentinel",
  "version": "1.1.0",
  "description": "Subresource Integrity (SRI) generator and checker: hashes <script> and <link> resources in built HTML (sha256/384/512, local and CDN), import maps, lazy webpack chunks, writes integrity + crossorigin, fails CI on missing, wrong or stale hashes. JSON manifest, Vite/webpack/Rollup/esbuild/Astro plugins, text/JSON/SARIF/Markdown output, GitHub Action. Zero dependencies.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./vite": {
      "import": {
        "types": "./dist/plugins/vite.d.ts",
        "default": "./dist/plugins/vite.mjs"
      },
      "require": {
        "types": "./dist/plugins/vite.d.ts",
        "default": "./dist/plugins/vite.cjs"
      }
    },
    "./webpack": {
      "import": {
        "types": "./dist/plugins/webpack.d.ts",
        "default": "./dist/plugins/webpack.mjs"
      },
      "require": {
        "types": "./dist/plugins/webpack.d.ts",
        "default": "./dist/plugins/webpack.cjs"
      }
    },
    "./rollup": {
      "import": {
        "types": "./dist/plugins/rollup.d.ts",
        "default": "./dist/plugins/rollup.mjs"
      },
      "require": {
        "types": "./dist/plugins/rollup.d.ts",
        "default": "./dist/plugins/rollup.cjs"
      }
    },
    "./esbuild": {
      "import": {
        "types": "./dist/plugins/esbuild.d.ts",
        "default": "./dist/plugins/esbuild.mjs"
      },
      "require": {
        "types": "./dist/plugins/esbuild.d.ts",
        "default": "./dist/plugins/esbuild.cjs"
      }
    },
    "./astro": {
      "import": {
        "types": "./dist/plugins/astro.d.ts",
        "default": "./dist/plugins/astro.mjs"
      },
      "require": {
        "types": "./dist/plugins/astro.d.ts",
        "default": "./dist/plugins/astro.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "sri-sentinel": "./dist/cli.cjs"
  },
  "files": [
    "dist",
    "bin",
    "action.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.js",
    "prepack": "npm run build"
  },
  "keywords": [
    "sri",
    "subresource-integrity",
    "integrity",
    "security",
    "cdn",
    "supply-chain-security",
    "hash",
    "sha384",
    "html",
    "importmap",
    "vite-plugin",
    "webpack-plugin",
    "rollup-plugin",
    "esbuild-plugin",
    "astro-integration",
    "sarif",
    "cli",
    "github-action",
    "devsecops"
  ],
  "author": "Louis Wright <hello@louiswright.co.uk> (https://github.com/MrLouisWright)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrLouisWright/sri-sentinel.git"
  },
  "bugs": {
    "url": "https://github.com/MrLouisWright/sri-sentinel/issues"
  },
  "homepage": "https://mrlouiswright.github.io/sri-sentinel/",
  "devDependencies": {
    "@types/node": "^22.13.10",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.2"
  }
}
